{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-test",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "prisma/seed.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-test"]
}
